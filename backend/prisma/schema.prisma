generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////////
// ENUMS (UNCHANGED - SAFE)
//////////////////////////////////////////////////////

enum AccountType {
  CASH
  BANK
  WALLET
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER_IN
  TRANSFER_OUT
  RECEIVABLE
  PAYABLE
}


enum PersonType {
  BORROWER
  LENDER
  CONTACT
}

enum CategoryType {
  INCOME
  EXPENSE
}

//////////////////////////////////////////////////////
// USER
//////////////////////////////////////////////////////

model User {
  id       String @id @default(cuid())
  name     String
  email    String @unique
  password String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts     Account[]
  transactions Transaction[]
  categories   Category[]
  persons      Person[]
}

//////////////////////////////////////////////////////
// ACCOUNT (FINAL — balance REMOVED)
//////////////////////////////////////////////////////

model Account {
  id String @id @default(cuid())

  name String
  type AccountType @default(BANK)

  currency String @default("USD")

  initialBalance Decimal @default(0) @db.Decimal(18, 4)

  // ❌ balance removed exactly as requested

  isArchived Boolean @default(false)
  deletedAt  DateTime?

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions      Transaction[] @relation("AccountTransactions")
  fromTransactions  Transaction[] @relation("FromAccount")
  toTransactions    Transaction[] @relation("ToAccount")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
  @@index([userId, isArchived])
  @@index([userId, deletedAt])
}

//////////////////////////////////////////////////////
// CATEGORY
//////////////////////////////////////////////////////

model Category {
  id String @id @default(cuid())

  name String
  type CategoryType

  color String?
  icon  String?

  isArchived Boolean @default(false)
  deletedAt  DateTime?

  parentId String?
  parent Category? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions Transaction[] @relation("CategoryTransactions")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name, type])
  @@index([userId])
  @@index([userId, type])
  @@index([userId, isArchived])
  @@index([userId, deletedAt])
}

//////////////////////////////////////////////////////
// PERSON
//////////////////////////////////////////////////////

model Person {
  id String @id @default(cuid())

  name String
  type PersonType @default(CONTACT)

  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions Transaction[]

  createdAt DateTime @default(now())

  @@unique([userId, name])
  @@index([userId])
}

//////////////////////////////////////////////////////
// TRANSACTION (UNCHANGED)
//////////////////////////////////////////////////////

model Transaction {
  id String @id @default(cuid())

  type TransactionType
  amount Decimal @db.Decimal(18, 4)

  description String?
  date DateTime @default(now())
  attachmentUrl String?

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String?
  account   Account? @relation("AccountTransactions", fields: [accountId], references: [id])

  fromAccountId String?
  fromAccount   Account? @relation("FromAccount", fields: [fromAccountId], references: [id])

  toAccountId String?
  toAccount   Account? @relation("ToAccount", fields: [toAccountId], references: [id])

  categoryId String?
  category   Category? @relation("CategoryTransactions", fields: [categoryId], references: [id], onDelete: SetNull)

  personId String?
  person   Person? @relation(fields: [personId], references: [id], onDelete: SetNull)

  isReversed Boolean @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, date])
  @@index([userId, type])
  @@index([userId, deletedAt])
  @@index([accountId])
  @@index([fromAccountId])
  @@index([toAccountId])
  @@index([categoryId])
}
