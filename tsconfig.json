{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["web/src/*"],
      "@backend/*": ["backend/src/*"],
      "@shared/*": ["shared/*"]
    }
  },
  "include": [
    "web",
    "backend",
    "shared"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".next"
  ]
}